        "--radius-sm": "calc(var(--radius) * 0.6)",
        "--radius-xl": "calc(var(--radius) * 1.4)",
        "--shadow-card": "var(--elevation-card)",
        "--shadow-drawer": "var(--elevation-drawer)",
        "--shadow-hover": "var(--elevation-hover)",
        "--shadow-overlay": "var(--elevation-overlay)",
        "--shadow-popover": "var(--elevation-popover)",
        "--shadow-raised": "var(--elevation-raised)"
      }
    }
  ]
}
